# Backend Configuration
PORT=5001
NODE_ENV=development
DATABASE_URL="postgresql://mikey@localhost:5432/trapbreaker?schema=public"
JWT_SECRET="trapbreaker-super-secret-jwt-key-2026"
CLIENT_ORIGIN="http://localhost:3000"

# Optional comma-separated additional frontend origins for HTTP and Socket.IO.
CLIENT_ORIGINS=""

# Optional coturn endpoints and server-side static-auth-secret.
# TURN_URLS="turn:turn.example.org:3478,turns:turn.example.org:5349"
TURN_SHARED_SECRET=""

# Optional LiveKit Video Configuration
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Frontend Configuration (.env.local)
NEXT_PUBLIC_API_URL="http://localhost:5001/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5001"

# Use the same Google web OAuth client ID on frontend and backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

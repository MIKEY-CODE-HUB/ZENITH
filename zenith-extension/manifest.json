{
  "manifest_version": 3,
  "name": "ZENITH Focus & Distraction Freeze Guardian",
  "version": "10.1.0",
  "description": "Locks all external websites with the Focus Broken UI and forces you back to your ZENITH focus room.",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "declarativeNetRequestWithHostAccess",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zenith-dusky-theta.vercel.app/*",
        "https://zenith-git-fix-zenith-room-re-944e0c-mikey-sketch-hubs-projects.vercel.app/*",
        "https://*-mikey-sketch-hubs-projects.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZENITH Focus Guardian"
  }
}

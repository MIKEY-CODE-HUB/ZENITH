{
  "manifest_version": 3,
  "name": "Zenith Shield",
  "version": "10.5.0",
  "minimum_chrome_version": "120",
  "description": "Blocks requests to distracting websites during protected Zenith focus sessions.",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "declarativeNetRequest",
    "alarms",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://zenith-dusky-theta.vercel.app/*",
    "https://zenith-git-fix-zenith-room-re-944e0c-mikey-sketch-hubs-projects.vercel.app/*",
    "https://zenith-git-fix-zenith-launch-6c62e3-mikey-sketch-hubs-projects.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zenith-dusky-theta.vercel.app/*",
        "https://zenith-git-fix-zenith-room-re-944e0c-mikey-sketch-hubs-projects.vercel.app/*",
        "https://zenith-git-fix-zenith-launch-6c62e3-mikey-sketch-hubs-projects.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zenith Shield"
  },
  "key": ""
}
